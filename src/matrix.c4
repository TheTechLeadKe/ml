use math::random_f64
use math::randomize_seed
use math as math

foreign "C"{
    fn malloc(u64 size)->void *
    fn printf(const char *format,...)->i32
}

struct Matrix{
    u32 rows
    u32 columns
    f64 *data
}

impl Matrix{
    fn init(u32 rows,u32 columns,f64 *data){
        if self->alloc(rows,columns) and (data != null){   
            self->set_elements(data)
        }
    }

    #[static(true)]
    fn new(u32 rows,u32 columns,f64 *data)->Matrix{
        Matrix node
        node.init(rows,columns,data)
        return node
    }

    #[static(true)]
    fn zero()->Matrix{
        return Matrix::new(0,0,null)
    }

    #[static(true)]
    fn zeroed(u32 rows,u32 cols)->Matrix{
        return Matrix::new(rows,cols,null)
    }


    #[static(true)]
    fn fill(u32 rows,u32 cols,f64 value)->Matrix{
        Matrix matrix = Matrix::new(rows,cols,null)

        if matrix.is_error(){
            return matrix
        }

        u64 ii = 0

        while ii < (matrix.get_rows() * matrix.get_columns()){
            matrix.data[ii] = value
            ii              += 1
        }

        return matrix
    }

    #[static(true)]
    fn random(u32 rows,u32 cols,f64 low,f64 high)->Matrix{
        Matrix matrix = Matrix::new(rows,cols,null)

        if matrix.is_error(){
            return matrix
        }

        u64 ii = 0

        while ii < (matrix.get_rows() * matrix.get_columns()){
            matrix.data[ii] = random_f64(low,high)
            ii              += 1
        }

        return matrix
    }

    fn alloc(u32 rows,u32 columns)->bool{
        self->rows    = rows
        self->columns = columns
        self->data    = malloc(sizeof(f64) * self->rows * self->columns)

        if !self->data{
            self->rows    = 0
            self->columns = 0
            self->data    = null
        }

        return self->get_data() != null
    }

    fn get_rows()->u32{
        return self->rows
    }

    fn get_columns()->u32{
        return self->columns
    }

    fn get_data()->f64 *{
        return self->data
    }

    fn is_error()->bool{
        return !self->get_rows() or !self->get_columns() or !self->get_data()
    }
    

    fn set_elements(f64 *data)->bool{
        if self->is_error() or !data{
            return false
        }

        u64 ii = 0

        while ii < (self->get_rows() * self->get_columns()){
            self->data[ii] = data[ii]
            ii             += 1
        }

        return true
    }

    fn is_same_shape(Matrix matrix)->bool{
        if matrix.is_error(){
            return false
        }

        return (self->get_rows() == matrix.get_rows()) and (self->get_columns() == matrix.get_columns())
    }


    fn is_dot_compatible(Matrix matrix)->bool{
        if matrix.is_error(){
            return false
        }

        return self->get_columns() == matrix.get_rows()
    }


    fn add(Matrix matrix)->Matrix{
        if !self->is_same_shape(matrix){
            return Matrix::zero()
        }

        Matrix result = Matrix::new(self->get_rows(),self->get_columns(),null)

        u64 ii = 0

        while ii < (self->get_rows() * self->get_columns()){
            result.data[ii] = self->data[ii] + matrix.data[ii]
            ii              += 1
        }

        return result
    }

    fn dot(Matrix matrix)->Matrix{
        if !self->is_dot_compatible(matrix){
            return Matrix::zero()
        }

        u32 inner     = self->get_columns()
        Matrix result = Matrix::zeroed(self->get_rows(),matrix.get_columns())

        if result.is_error(){
            return result
        }

        u64 ii = 0

        while ii < result.get_rows(){
            u64 jj = 0

            while jj < result.get_columns(){
                result.set_data_at(ii,jj,0)

                u64 kk = 0

                while kk < inner{
                    result.add_to_data_at(ii,jj,self->get_data_at(ii,kk) * matrix.get_data_at(kk,jj))
                    kk += 1
                }

                jj += 1
            }

            ii += 1
        }

        return result
    }


    fn add_raw(Matrix *mat1,Matrix *mat2)->bool{
        if !mat1 or !mat2 or !self->is_same_shape(mat1@read()) or !self->is_same_shape(mat2@read()){
            return false
        }

        u64 ii = 0

        while ii < (self->get_rows() * self->get_columns()){
            self->data[ii] = mat1->data[ii] + mat2->data[ii]
            ii               += 1
        }

        return true
    }

    fn dot_raw(Matrix *mat1,Matrix *mat2)->bool{
        if !mat1 or !mat2 or !mat1->is_dot_compatible(mat2@read()) or (self->get_rows() != mat1->get_rows()) or (self->get_columns() != mat2->get_columns()){
            return false
        }

        u32 inner = mat1->get_columns()
        u64 ii    = 0

        while ii < self->get_rows(){
            u64 jj = 0

            while jj < self->get_columns(){
                self->set_data_at(ii,jj,0)

                u64 kk = 0

                while kk < inner{
                    self->add_to_data_at(ii,jj,mat1->get_data_at(ii,kk) * mat2->get_data_at(kk,jj))
                    kk += 1
                }

                jj += 1
            }

            ii += 1
        }

        return true
    }


    fn get_data_at(u32 x,u32 y)->f64{
        return self->data[(x * self->get_columns()) + y]
    }


    fn set_data_at(u32 x,u32 y,f64 value){
        self->data[(x * self->get_columns()) + y] = value
    }

    fn add_to_data_at(u32 x,u32 y,f64 value){
        self->data[(x * self->get_columns()) + y] += value
    }



    fn print()->bool{
        if self->is_error(){
            return false
        }

        printf("\nshape (rows=%u  columns=%u)\n[\n",self->get_rows(),self->get_columns())

        u64 x = 0

        while x < self->get_rows(){
            printf("\t")
            u64 y = 0
            
            while y < self->get_columns(){
                printf("%11.6lf ",self->get_data_at(x,y))
                y += 1
            }

            printf("\n")

            x += 1
        }

        printf("]\n")

        return true
    }
}



