use matrix::Matrix


#[no_mangle]
fn main()->i32{
    f64 [4]data
    data[0]  = 90
    data[1]  = 70 
    data[2]  = 30 
    data[3]  = 10 

    Matrix a = Matrix::new(2,2,data as f64 *)
    Matrix b = a.add(a)
    Matrix c = Matrix::zeroed(2,2)

    a.print()
    b.print()
    c.print()
    return 0
}
