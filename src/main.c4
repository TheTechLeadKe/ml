use nn::NN
use math::randomize_seed

foreign "C"{
    fn printf(const char *format,...)->i32
}


#[no_mangle]
fn main()->i32{
    randomize_seed()
    u64 [3]arch
    arch[0] = 2
    arch[1] = 2
    arch[2] = 1

    f64 [2]inputs
    inputs[0] = 2
    inputs[1] = 4

    NN nn1 = NN::new(arch,3,0,20,inputs)
    printf("[ Before FEED FORWARD ]\n")
    nn1.print()
    nn1.forward()
    printf("[ After FEED FORWARD ]\n")
    nn1.print()
    return 0
}
